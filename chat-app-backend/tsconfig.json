{
	"compilerOptions": {
		"module": "nodenext",
		"target": "es2022",
		"types": ["node"],
		"rootDir": "src",
		"outDir": "dist",
		"sourceMap": true,

		"strict": true,
		"noUncheckedIndexedAccess": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"skipLibCheck": true
	},
	"include": ["src"]
}
